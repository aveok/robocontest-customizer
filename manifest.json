{
  "manifest_version": 3,
  "name": "RC Theme",
  "version": "0.2.0",
  "description": "Unofficial. Clean, compact redesign for robocontest.uz: modern dark/light theme, compact tables, less clutter.",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "RC Theme",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://robocontest.uz/*", "https://*.robocontest.uz/*"],
      "css": [
        "styles/tokens.css",
        "styles/base.css",
        "styles/layout.css",
        "styles/components.css",
        "styles/pages/tasks.css",
        "styles/declutter.css",
        "styles/editor.css"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
